# --- Database ---
DB_USER=rekap_user
DB_PASSWORD=rekap_pass
DB_NAME=rekap_db

# --- Tokopedia API ---
# client_id/secret didapat sekali per aplikasi dari Tokopedia Developer
# Portal. Toko yang terhubung TIDAK lagi di sini - dikelola dinamis lewat
# halaman Sinkronisasi (tabel channel_accounts), bisa lebih dari satu toko.
TOKOPEDIA_CLIENT_ID=
TOKOPEDIA_CLIENT_SECRET=
# Placeholder - konfirmasi URL persis di dashboard aplikasi kamu sebelum pakai.
TOKOPEDIA_AUTHORIZE_URL=https://accounts.tokopedia.com/oauth/authorize
TOKOPEDIA_TOKEN_URL=https://fs.tokopedia.net/token

# --- Shopee API ---
# partner_id/key didapat sekali per aplikasi dari Shopee Open Platform.
# Toko dikelola dinamis lewat halaman Sinkronisasi, sama seperti Tokopedia.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
SHOPEE_BASE_URL=https://partner.shopeemobile.com

# --- TikTok Shop API ---
# app_key/secret didapat sekali per aplikasi dari TikTok Shop Partner Center.
# Toko dikelola dinamis lewat halaman Sinkronisasi, sama seperti channel lain.
TIKTOKSHOP_APP_KEY=
TIKTOKSHOP_APP_SECRET=
# Placeholder - konfirmasi URL persis di partner.tiktokshop.com sebelum pakai.
TIKTOKSHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOKSHOP_BASE_URL=https://auth.tiktok-shops.com

# --- App ---
# WAJIB diganti untuk production - jangan pernah pakai nilai placeholder ini.
# Generate dengan: openssl rand -hex 32
JWT_SECRET=ganti_dengan_random_string_yang_panjang
TOKEN_ENCRYPTION_KEY=ganti_dengan_random_string_yang_panjang_juga
PORT=3000
# URL publik yang bisa diakses BROWSER pengguna (bukan nama service Docker) -
# dipakai untuk redirect_uri OAuth & redirect balik setelah connect toko.
# Di production, ganti ke https://domain-kamu.com untuk keduanya.
BACKEND_PUBLIC_URL=http://localhost:3000
FRONTEND_PUBLIC_URL=http://localhost:3001

# --- AI copilot (opsional; fitur tetap mati tanpa kedua nilai ini) ---
# Simpan hanya di environment backend. Jangan gunakan prefix NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=
